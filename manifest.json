{
  "manifest_version": 3,
  "name": "DesireMovies Bypass",
  "version": "1.0",
  "description": "Automates multi-hop download bypasses and cleans filenames for DesireMovies.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "*://*.gdflix.io/*",
    "*://*.gdflix.dev/*",
    "*://*.busycdn.xyz/*",
    "*://*.gyanigurus.xyz/*",
    "*://*.fastcdn-dl.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.1desiremovies.dad/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
