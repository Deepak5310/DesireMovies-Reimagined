{
  "manifest_version": 3,
  "name": "DesireMovies Reimagined",
  "version": "1.0.0",
  "description": "Transforms DesireMovies into a modern streaming platform UI — Netflix-style grid, clean titles, quality badges, and glassmorphic design.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DesireMovies Reimagined"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "scripting", "webNavigation"],
  "host_permissions": [
    "<all_urls>",
    "https://sg.media-imdb.com/*",
    "https://www.imdb.com/*",
    "https://gyanigurus.xyz/*",
    "https://new.gdflix.io/*",
    "https://fastcdn-dl.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gyanigurus.xyz/*"],
      "js": ["shield.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gyanigurus.xyz/*"],
      "js": ["gyanigurus.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://new.gdflix.io/*"],
      "js": ["gdflix.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://fastcdn-dl.pages.dev/*"],
      "js": ["fastcdn.js"],
      "run_at": "document_end"
    }
  ]
}
