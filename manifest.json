{
  "manifest_version": 3,
  "name": "DesireMovies Bypass",
  "version": "3.0.0",
  "description": "Automates multi-hop download bypasses and cleans filenames for DesireMovies and KatMovieHD.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DesireMovies Bypass",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "*://*.gyanigurus.xyz/*",
    "*://*.gdflix.io/*",
    "*://*.gdflix.dev/*",
    "*://*.busycdn.xyz/*",
    "*://*.fastcdn-dl.pages.dev/*",
    "*://*.foxcloud.rest/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.gyanigurus.xyz/*",
        "*://*.gdflix.io/*",
        "*://*.fastcdn-dl.pages.dev/*",
        "*://*.foxcloud.rest/*",
        "*://*.kmhd.eu/*"
      ],
      "js": ["automation.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.1desiremovies.dad/*", "*://*.katmoviehd.top/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
