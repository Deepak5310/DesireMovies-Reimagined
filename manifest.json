{
  "manifest_version": 3,
  "name": "DesireMovies Bypass & Stream",
  "version": "1.1.0",
  "description": "Automates multi-hop download bypasses, cleans filenames, and provides an in-page stream player.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {},
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["player.css"],
      "run_at": "document_idle"
    }
  ]
}
