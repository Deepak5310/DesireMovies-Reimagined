{
  "manifest_version": 3,
  "name": "DesireMovies Automation",
  "version": "2.2.0",
  "description": "Automates multi-hop download link bypass (Gyanigurus → GDFlix → FastCDN, KMHD → GDFlix → FastCDN) and normalizes downloaded filenames.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DesireMovies Automation"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["downloads", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["automation.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
