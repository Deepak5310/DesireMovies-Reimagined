{
  "manifest_version": 3,
  "name": "DesireMovies Bypass",
  "version": "1.0",
  "description": "Automates multi-hop download bypasses and cleans filenames for DesireMovies.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {},
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "storage", "scripting"],
  "host_permissions": ["<all_urls>"]
}
