{
  "manifest_version": 3,
  "name": "CinePass: Magic Auto Bypass",
  "version": "2.1.1",
  "description": "Instantly bypasses movie link shorteners (Gyanigurus, KatMovieHD, GDFlix, FastCDN) and automates file downloads.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DesireMovies Automation"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["automation.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
